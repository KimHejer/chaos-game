<?xml version="1.0" encoding="UTF-8"?>
<!-- Project Object Model (POM) file for Maven -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- Model version of the project descriptor -->
    <modelVersion>4.0.0</modelVersion>

    <!-- Group ID is the package name of the project -->
    <groupId>no.ntnu.idatg2003.chaos-game-gr8</groupId>
    <!-- Artifact ID is the name of the project -->
    <artifactId>idatg2003-2024-gruppe8</artifactId>
    <!-- Version of the project -->
    <version>1.0</version>

    <properties>
        <!-- Java source version -->
        <maven.compiler.source>21</maven.compiler.source>
        <!-- Java target version -->
        <maven.compiler.target>21</maven.compiler.target>
        <!-- Encoding for source files -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Version properties -->
        <junit.jupiter.version>5.10.1</junit.jupiter.version>
        <javafx.version>21.0.1</javafx.version>
        <maven.compiler.plugin.version>3.12.1</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.2.3</maven.surefire.plugin.version>
        <javafx.maven.plugin.version>0.0.8</javafx.maven.plugin.version>
        <maven.javadoc.plugin.version>3.4.1</maven.javadoc.plugin.version>
    </properties>

    <dependencies>
        <!-- JUnit Jupiter dependency for unit testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- JavaFX Controls dependency for GUI components -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Maven Compiler Plugin for compiling the project -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
            </plugin>
            <!-- Maven Surefire Plugin for running unit tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
            </plugin>
            <!-- JavaFX Maven Plugin for running JavaFX applications -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.maven.plugin.version}</version>
                <configuration>
                    <!-- Main class of the JavaFX application -->
                    <mainClass>no.ntnu.idatg2003.chaos.game.gr8.ChaosGameApp</mainClass>
                </configuration>
            </plugin>
            <!-- Maven Javadoc Plugin for generating Javadoc -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven.javadoc.plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>javadoc</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
